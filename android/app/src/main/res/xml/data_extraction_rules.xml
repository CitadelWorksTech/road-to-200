<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up only the app's data copy, to Google and when moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
